<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>上滑返回</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>上滑返回（左下/右下角上滑 = 返回上一级）</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>defaults</key>
			<string>com.doubao.swipeback</string>
			<key>key</key>
			<string>SwipeBackEnabled</string>
			<key>label</key>
			<string>启用上滑返回</string>
			<key>default</key>
			<false/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>触发区域</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSMultiValueCell</string>
			<key>defaults</key>
			<string>com.doubao.swipeback</string>
			<key>key</key>
			<string>SwipeBackArea</string>
			<key>label</key>
			<string>触发角落</string>
			<key>default</key>
			<integer>2</integer>
			<key>titles</key>
			<array>
				<string>左下角</string>
				<string>右下角</string>
				<string>两侧</string>
			</array>
			<key>values</key>
			<array>
				<integer>0</integer>
				<integer>1</integer>
				<integer>2</integer>
			</array>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>灵敏度</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>defaults</key>
			<string>com.doubao.swipeback</string>
			<key>key</key>
			<string>SwipeBackSensitivity</string>
			<key>label</key>
			<string>灵敏度（0.1~1.0）</string>
			<key>default</key>
			<real>0.5</real>
			<key>min</key>
			<real>0.1</real>
			<key>max</key>
			<real>1.0</real>
			<key>isInverted</key>
			<false/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>说明：在所选角落往上滑一次=返回上一级；上滑到屏幕中间=呼出后台；二次上滑确认=回桌面（后续版本）。</string>
		</dict>
	</array>
</dict>
</plist>
